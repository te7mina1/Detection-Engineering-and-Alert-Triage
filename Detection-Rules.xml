<group name="linux,sshd,syslog,authentication,detection_engineering,">

    <rule id="100104" level="10" frequency="5" timeframe="120" ignore="60">

        <if_matched_sid>5760</if_matched_sid>

        <same_srcip />

        <description>Possible SSH password guessing: 5 failed authentication attempts from the same source IP within 120 seconds on $(hostname).</description>

        <mitre>
            <id>T1110.001</id>
        </mitre>

        <group>attack,credential_access,password_guessing,ssh,authentication_failures,</group>

    </rule>

</group>
