<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>


<!-- Windows Endpoint Detection Rules. -->


<group name="windows,sysmon,powershell,detection_engineering,">

    <rule id="100100" level="10">
        <if_group>sysmon_event1</if_group>

        <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>

        <field name="win.eventdata.commandLine" type="pcre2">(?i)(-nop( |$)|-noprofile( |$)|-w[[:space:]]+hidden|-windowstyle[[:space:]]+hidden|-executionpolicy[[:space:]]+bypass|-ep[[:space:]]+bypass|invoke-expression|iex[[:space:]]|downloadstring|downloadfile|frombase64string)</field>

        <description>Suspicious PowerShell execution detected on $(win.system.computer).</description>

        <mitre>
            <id>T1059.001</id>
        </mitre>

        <group>attack,execution,powershell,</group>
    </rule>

</group>


<group name="windows,sysmon,powershell,encoded_command,detection_engineering,">

    <rule id="100101" level="12">
        <if_group>sysmon_event1</if_group>

        <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>

        <field name="win.eventdata.commandLine" type="pcre2">(?i)(^|[[:space:]])-(enc|encodedcommand)([[:space:]]|$)</field>

        <description>Encoded PowerShell command detected on $(win.system.computer).</description>

        <mitre>
            <id>T1059.001</id>
        </mitre>

        <group>attack,execution,powershell,encoded_command,</group>
    </rule>

</group>


<group name="windows,sysmon,command_shell,detection_engineering,">

    <rule id="100102" level="9">
        <if_group>sysmon_event1</if_group>

        <field name="win.eventdata.image" type="pcre2">(?i)\\cmd\.exe$</field>

        <field name="win.eventdata.commandLine" type="pcre2">(?i)(net[[:space:]]+(user|localgroup|group)|whoami|systeminfo|tasklist|ipconfig|reg[[:space:]]+add|sc[[:space:]]+(create|config|start)|wevtutil)</field>

        <description>Security-relevant Windows Command Shell activity detected on $(win.system.computer).</description>

        <mitre>
            <id>T1059.003</id>
        </mitre>

        <group>attack,execution,windows_command_shell,</group>
    </rule>

</group>


<group name="windows,sysmon,scheduled_task,persistence,detection_engineering,">

    <rule id="100103" level="11">
        <if_group>sysmon_event1</if_group>

        <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>

        <field name="win.eventdata.commandLine" type="pcre2">(?i)(^|[[:space:]])/(create|change)([[:space:]]|$)</field>

        <description>Scheduled task creation or modification detected on $(win.system.computer).</description>

        <mitre>
            <id>T1053.005</id>
        </mitre>

        <group>attack,persistence,scheduled_task,</group>
    </rule>

</group>



